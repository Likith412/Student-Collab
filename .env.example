# ---------------------------------------------------------------------------
# Docker Compose environment
#
# Compose reads a file named .env in this directory automatically. Copy this
# file to .env and fill it in — .env is gitignored.
#
#   cp .env.example .env
#
# The development stack runs without any of this; every value below has a
# working default in docker-compose.yml. The production stack requires
# JWT_SECRET.
# ---------------------------------------------------------------------------

# Signs the JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Public url of the app, used for cors and for links inside emails.
# Development defaults to http://localhost:5173, production to :8080.
APP_URL=http://localhost:8080

# How many queued emails are processed at once.
QUEUE_CONCURRENCY=5

# SMTP is optional. Leave SMTP_HOST empty and the backend logs emails to the
# console instead of sending them. For Gmail, SMTP_PASSWORD is an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
