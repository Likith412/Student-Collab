{
   "arrowParens": "avoid",
   "bracketSpacing": true,
   "endOfLine": "lf",
   "insertPragma": false,
   "printWidth": 90,
   "proseWrap": "always",
   "quoteProps": "as-needed",
   "requirePragma": false,
   "semi": true,
   "singleQuote": false,
   "tabWidth": 3,
   "trailingComma": "es5",
   "useTabs": false
}